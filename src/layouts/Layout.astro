---
import '../styles/global.css';
import { profile } from '../data/profile';
import { defaultLocale, type LocalizedText } from '../i18n';

interface Props {
  title: LocalizedText;
  description: string;
}

const { title, description } = Astro.props;

if (!Astro.site) {
  throw new Error('Set `site` in astro.config.mjs: canonical and social URLs must be absolute.');
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang={defaultLocale} data-title-en={title.en} data-title-fr={title.fr}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title[defaultLocale]}</title>
    <script is:inline>
      // Apply the visitor's stored language before first paint (same key as LanguageToggle.astro).
      try {
        if (localStorage.getItem('portfolio-language') === 'fr') {
          document.documentElement.lang = 'fr';
          document.title = document.documentElement.dataset.titleFr || document.title;
        }
      } catch {
        // Storage unavailable: keep the default language.
      }
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.fullName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="fr_FR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title[defaultLocale]} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={profile.seo.imageAlt} />
    {/* X/Twitter falls back to the Open Graph tags above for title, description and image. */}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
