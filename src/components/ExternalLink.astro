---
import { ui } from '../i18n';
import Localized from './Localized.astro';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer">
  <slot />
  {' '}
  <span class="visually-hidden">
    <Localized text={ui.opensInNewTab} />
  </span>
</a>
