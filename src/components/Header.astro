---
import { profile } from '../data/profile';
import { sections } from '../data/sections';
import { localizedAriaLabel, ui } from '../i18n';
import LanguageToggle from './LanguageToggle.astro';
import Localized from './Localized.astro';
---

<header class="site-header" id="top">
  <div class="content header-content">
    <nav {...localizedAriaLabel(ui.primaryNavigation)}>
      <a class="wordmark" href="#top">{profile.shortName}</a>
      <div class="nav-actions">
        <ul class="nav-links">
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>
                  <Localized text={section.title} />
                </a>
              </li>
            ))
          }
        </ul>
        <LanguageToggle />
      </div>
    </nav>

    <div class="introduction">
      <p class="eyebrow"><Localized text={profile.headline} /></p>
      <h1>{profile.displayName}</h1>
      <ul class="profile-links" {...localizedAriaLabel(ui.professionalLinks)}>
        {
          profile.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>
