---
import { experiences } from '../data/experiences';
import { formatYearMonth, ui } from '../i18n';
import Localized from './Localized.astro';
import Section from './Section.astro';
---

<Section id="experience">
  <div class="experience-list">
    {
      experiences.map((experience) => (
        <article class="experience-item">
          <h3 class="experience-title">
            <Localized text={experience.role} />
            <span class="visually-hidden">, </span>
            <span class="company">{experience.company}</span>
          </h3>
          <p class="experience-meta">
            <span>
              <time datetime={experience.start}>
                <Localized text={formatYearMonth(experience.start)} />
              </time>
              {' – '}
              {experience.end ? (
                <time datetime={experience.end}>
                  <Localized text={formatYearMonth(experience.end)} />
                </time>
              ) : (
                <Localized text={ui.present} />
              )}
            </span>
            {' '}
            <span><Localized text={experience.location} /></span>
          </p>
          <div class="experience-body">
            <ul class="highlights">
              {experience.highlights.map((highlight) => (
                <li>
                  <Localized text={highlight} />
                </li>
              ))}
            </ul>
            <p class="visually-hidden">Technologies</p>
            <ul class="tag-list">
              {experience.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</Section>
