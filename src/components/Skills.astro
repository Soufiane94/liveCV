---
import { skillCategories } from '../data/skills';
import Localized from './Localized.astro';
import Section from './Section.astro';
---

<Section id="skills">
  {
    skillCategories.map((category) => (
      <section class="skill-category" aria-labelledby={`skills-${category.id}`}>
        <h3 class="skill-category-title" id={`skills-${category.id}`}>
          <Localized text={category.name} />
        </h3>
        <div class="skills-grid">
          {category.groups.map((group) => (
            <section class="skill-group" aria-labelledby={`skills-${category.id}-${group.id}`}>
              <h4 id={`skills-${category.id}-${group.id}`}>
                <Localized text={group.name} />
              </h4>
              <ul>
                {group.skills.map((skill) => (
                  <li>
                    <Localized text={skill} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
    ))
  }
</Section>
