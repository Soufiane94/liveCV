---
import { skillGroups } from '../data/skills';
---

<section class="section" id="skills" aria-labelledby="skills-heading">
  <div class="content section-grid">
    <h2 id="skills-heading"><span data-language="en">Skills</span><span data-language="fr" lang="fr" hidden>Compétences</span></h2>
    <div class="section-content skills-grid">
      {
        skillGroups.map((group, index) => (
          <section class="skill-group" aria-labelledby={`skill-${index}`}>
            <h3 id={`skill-${index}`}><span data-language="en">{group.name.en}</span><span data-language="fr" lang="fr" hidden>{group.name.fr}</span></h3>
            <ul>
              {group.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
