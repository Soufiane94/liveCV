---
import { profile } from '../data/profile';
import Localized from './Localized.astro';
import Section from './Section.astro';
---

<Section id="about">
  <div class="prose">
    {
      profile.about.map((paragraph) => (
        <p>
          <Localized text={paragraph} />
        </p>
      ))
    }
    <p class="quote" lang="en">{profile.quote.text} ~ <i>{profile.quote.author}</i></p>
  </div>
</Section>
