---
import { certifications } from '../data/certifications';
import { ui } from '../i18n';
import Localized from './Localized.astro';
import Section from './Section.astro';
---

<Section id="certifications">
  <ul class="certification-list">
    {
      certifications.map((certification) => (
        <li>
          <span class="certification-code">{certification.code}</span>
          <a href={certification.url} target="_blank" rel="noopener noreferrer">
            <Localized text={certification.name} />
            <span class="visually-hidden">
              <Localized text={ui.opensInNewTab} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
